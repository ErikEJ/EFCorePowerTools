<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup Label="Compile settings">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1573,1591,1712,CA1014</NoWarn>
    <LangVersion>latest</LangVersion>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  
  <PropertyGroup Label="Analyzer settings">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <AnalysisLevelStyle>latest-all</AnalysisLevelStyle>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Legacy projects need the analyzer package and cannot resolve the SDK's "latest" analysis level. -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' != 'true' And '$(MSBuildProjectExtension)' == '.csproj'">
    <AnalysisLevel>9.0-all</AnalysisLevel>
    <AnalysisLevelStyle>9.0-all</AnalysisLevelStyle>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsingMicrosoftNETSdk)' != 'true' And '$(MSBuildProjectExtension)' == '.csproj'">
    <!-- Roslyn 4.14 supports the Visual Studio 2022 compiler used by the existing build workflow. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.18-beta">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7" PrivateAssets="All" />
  </ItemGroup>

</Project>